rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // UID Firebase autorizzati. Mai usare password/token nel repository.
    function member() {
      return request.auth != null && request.auth.uid in [
        'SOSTITUISCI_CON_UID_PRIMO_FAMILIARE'
      ];
    }
    match /families/famiglia/lists/{listId} {
      allow read, write: if member();
    }
    match /families/famiglia/tasks/{taskId} {
      allow read, write: if member();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}